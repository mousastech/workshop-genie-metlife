ame": "data_liquidacao", "description": ["Data de liquidacao (pagamento/encerramento)"]}, {"column_name": "data_ocorrencia", "description": ["Data de ocorrencia do evento"]}, {"column_name": "dias_desde_emissao", "description": ["Dias entre a emissao da apolice e a ocorrencia do sinistro"]}, {"column_name": "dias_liquidacao", "description": ["Dias entre aviso e liquidacao (tempo de regulacao)"], "synonyms": ["tempo de regulacao", "prazo"]}, {"column_name": "linha_negocio", "description": ["Linha de negocio: Vida ou Previdencia"], "synonyms": ["ramo"], "enable_entity_matching": true}, {"column_name": "nome_produto", "description": ["Produto associado ao sinistro"], "synonyms": ["produto"], "enable_entity_matching": true}, {"column_name": "numero_sinistro", "description": ["Numero unico do sinistro"], "synonyms": ["sinistro"]}, {"column_name": "produto_id", "description": ["Chave para a tabela produtos"]}, {"column_name": "regiao", "description": ["Regiao do Brasil"], "enable_entity_matching": true}, {"column_name": "sinistro_id", "description": ["Chave primaria do sinistro"]}, {"column_name": "status_sinistro", "description": ["Status: Pago, Em Analise, Negado, Aprovado"], "synonyms": ["situacao"], "enable_entity_matching": true}, {"column_name": "suspeita_fraude", "description": ["Indicador booleano de suspeita de fraude"], "synonyms": ["fraude"], "enable_entity_matching": true}, {"column_name": "tipo_sinistro", "description": ["Tipo de sinistro (Morte Natural, Morte Acidental, Invalidez, Doenca Grave, Resgate, etc.)"], "synonyms": ["causa"], "enable_entity_matching": true}, {"column_name": "uf", "description": ["Estado"], "synonyms": ["estado"], "enable_entity_matching": true}, {"column_name": "valor_pago", "description": ["Valor efetivamente pago do sinistro"], "synonyms": ["indenizacao"]}, {"column_name": "valor_reclamado", "description": ["Valor reclamado pelo beneficiario"], "synonyms": ["valor pedido"]}]}, {"identifier": "moi_ai_catalog.metlife_workshop.sinistros_fraude_score", "column_configs": [{"column_name": "apolice_id", "description": ["Chave para a tabela apolices"]}, {"column_name": "dias_desde_emissao", "description": ["Dias entre emissao da apolice e ocorrencia"]}, {"column_name": "motivo_alerta_principal", "description": ["Motivo principal do alerta de fraude"], "synonyms": ["motivo"]}, {"column_name": "nivel_risco", "description": ["Nivel de risco: Baixo, Medio, Alto"], "synonyms": ["risco"], "enable_entity_matching": true}, {"column_name": "numero_sinistro", "description": ["Numero do sinistro relacionado"]}, {"column_name": "score_fraude", "description": ["Score de risco de fraude de 0 a 100"], "synonyms": ["score", "pontuacao de fraude"]}, {"column_name": "sinistro_id", "description": ["Chave para a tabela sinistros"]}, {"column_name": "suspeita_fraude", "description": ["Indicador de suspeita de fraude"], "synonyms": ["fraude"], "enable_entity_matching": true}, {"column_name": "tipo_sinistro", "description": ["Tipo do sinistro"], "enable_entity_matching": true}, {"column_name": "valor_reclamado", "description": ["Valor reclamado no sinistro"]}]}]}, "instructions": {"example_question_sqls": [{"id": "5e6c1292d1874cababc389c37654466a", "question": ["Valor pago em sinistros por mes em 2025"], "sql": ["SELECT date_format(data_liquidacao,'yyyy-MM') AS mes, ROUND(SUM(valor_pago),2) AS valor_pago FROM moi_ai_catalog.metlife_workshop.sinistros WHERE status_sinistro = 'Pago' AND YEAR(data_liquidacao) = 2025 GROUP BY date_format(data_liquidacao,'yyyy-MM') ORDER BY mes"]}, {"id": "68354d837c9a416f96e42dcd4b6e799c", "question": ["Quantas apolices ativas por linha de negocio?"], "sql": ["SELECT linha_negocio, COUNT(*) AS apolices_ativas FROM moi_ai_catalog.metlife_workshop.apolices WHERE status_apolice = 'Ativa' GROUP BY linha_negocio ORDER BY apolices_ativas DESC"]}, {"id": "692926294576402baf5c694b572ee137", "question": ["Sinistros de alto risco de fraude com valor reclamado"], "sql": ["SELECT f.nivel_risco, COUNT(*) AS qtd, ROUND(SUM(f.valor_reclamado),2) AS valor_reclamado_total FROM moi_ai_catalog.metlife_workshop.sinistros_fraude_score f WHERE f.nivel_risco = 'Alto' GROUP BY f.nivel_risco"]}, {"id": "a48cf9d2cdf2450f9f3002e0c1149ac8", "question": ["Top 10 corretores por producao de premio mensal"], "sql": ["SELECT c.nome_corretor, c.canal_distribuicao, ROUND(SUM(a.premio_mensal),2) AS premio_total FROM moi_ai_catalog.metlife_workshop.apolices a JOIN moi_ai_catalog.metlife_workshop.corretores c ON a.corretor_id = c.corretor_id WHERE a.status_apolice = 'Ativa' GROUP BY c.nome_corretor, c.canal_distribuicao ORDER BY premio_total DESC LIMIT 10"]}, {"id": "bbd63e58aca5425ab882875d167d9c02", "question": ["Tempo medio de liquidacao de sinistros por tipo"], "sql": ["SELECT tipo_sinistro, ROUND(AVG(dias_liquidacao),1) AS dias_medios, COUNT(*) AS qtd FROM moi_ai_catalog.metlife_workshop.sinistros WHERE dias_liquidacao IS NOT NULL GROUP BY tipo_sinistro ORDER BY dias_medios DESC"]}, {"id": "e07c70dbb92f4c20b61ff1fb03c45ec8", "question": ["Taxa de inadimplencia por canal"], "sql": ["SELECT canal_distribuicao, ROUND(100.0 * SUM(CASE WHEN status_pagamento = 'Inadimplente' THEN 1 ELSE 0 END) / COUNT(*), 2) AS pct_inadimplencia FROM moi_ai_catalog.metlife_workshop.premios GROUP BY canal_distribuicao ORDER BY pct_inadimplencia DESC"]}], "text_instructions": [{"id": "cb8672bbe50b4da19276c99f6ed5b18a", "content": ["## PURPOSE", "- Agente para analise de seguros da MetLife: Vida, Previdencia, sinistros/fraude e distribuicao (corretores/canais).", "- Publico: analistas de negocio e time de dados. Assuma fluencia em seguros.", "## DISAMBIGUATION", "- 'Premio' refere-se ao valor pago pelo segurado (premios.valor_devido / apolices.premio_mensal), nunca a premiacao.", "- 'Capital segurado' existe apenas para linha_negocio = 'Vida'; para Previdencia use reserva_acumulada.", "- 'Sinistralidade' = valor_pago de sinistros dividido por premios; 'inadimplencia' = premios com status_pagamento = 'Inadimplente'.", "- 'Producao' de corretor = soma de premio_mensal das apolices originadas.", "## DATA QUALITY NOTES", "- apolices.capital_segurado e 0 para Previdencia; nao usar em medias gerais sem filtrar linha_negocio = 'Vida'.", "- premios.data_pagamento e NULL quando status_pagamento = 'Inadimplente'.", "- sinistros.dias_liquidacao e NULL enquanto o sinistro esta 'Em Analise'.", "## Instructions you must follow when providing summaries", "- Sempre informe o periodo considerado e arredonde valores monetarios para 2 casas decimais.", "- Ao falar de fraude, cite a quantidade e o percentual sobre o total de sinistros."]}], "join_specs": [{"id": "4f1675e9e15a44cca98a69f8e37db3de", "left": {"identifier": "moi_ai_catalog.metlife_workshop.apolices", "alias": "apolices"}, "right": {"identifier": "moi_ai_catalog.metlife_workshop.corretores", "alias": "corretores"}, "sql": ["`apolices`.`corretor_id` = `corretores`.`corretor_id`", "--rt=FROM_RELATIONSHIP_TYPE_MANY_TO_ONE--"]}, {"id": "93efbe6ddd14479e99b429f4fd5ce84b", "left": {"identifier": "moi_ai_catalog.metlife_workshop.sinistros_fraude_score", "alias": "sinistros_fraude_score"}, "right": {"identifier": "moi_ai_catalog.metlife_workshop.sinistros", "alias": "sinistros"}, "sql": ["`sinistros_fraude_score`.`sinistro_id` = `sinistros`.`sinistro_id`", "--rt=FROM_RELATIONSHIP_TYPE_ONE_TO_ONE--"]}, {"id": "a1e5b4810acb462fbf69e5e8b8b248a2", "left": {"identifier": "moi_ai_catalog.metlife_workshop.apolices", "alias": "apolices"}, "right": {"identifier": "moi_ai_catalog.metlife_workshop.clientes", "alias": "clientes"}, "sql": ["`apolices`.`cliente_id` = `clientes`.`cliente_id`", "--rt=FROM_RELATIONSHIP_TYPE_MANY_TO_ONE--"]}, {"id": "a63cbc229692460e84df0a11c6221266", "left": {"identifier": "moi_ai_catalog.metlife_workshop.apolices", "alias": "apolices"}, "right": {"identifier": "moi_ai_catalog.metlife_workshop.produtos", "alias": "produtos"}, "sql": ["`apolices`.`produto_id` = `produtos`.`produto_id`", "--rt=FROM_RELATIONSHIP_TYPE_MANY_TO_ONE--"]}, {"id": "a90fbaa08a54460db5ec46d3dd650094", "left": {"identifier": "moi_ai_catalog.metlife_workshop.sinistros", "alias": "sinistros"}, "right": {"identifier": "moi_ai_catalog.metlife_workshop.apolices", "alias": "apolices"}, "sql": ["`sinistros`.`apolice_id` = `apolices`.`apolice_id`", "--rt=FROM_RELATIONSHIP_TYPE_MANY_TO_ONE--"]}, {"id": "b326607eafc74a8d80e17522b6588bcf", "left": {"identifier": "moi_ai_catalog.metlife_workshop.premios", "alias": "premios"}, "right": {"identifier": "moi_ai_catalog.metlife_workshop.apolices", "alias": "apolices"}, "sql": ["`premios`.`apolice_id` = `apolices`.`apolice_id`", "--rt=FROM_RELATIONSHIP_TYPE_MANY_TO_ONE--"]}]}}
